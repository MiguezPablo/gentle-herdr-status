{
	"name": "gentle-herdr-status",
	"version": "0.4.0",
	"description": "Pi extension that shows in the Herdr sidebar the running subagent ($subagent), the orchestrator phase ($phase), the running jobs ($jobs) and the panel name ($name). Pane state and notifications stay with Herdr's official Pi integration.",
	"license": "MIT",
	"author": "Pablo Miguez",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"herdr",
		"subagents",
		"jobs"
	],
	"pi": {
		"extensions": [
			"./extensions/pi-herdr-status.ts"
		]
	},
	"files": [
		"extensions",
		"src",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"test": "node --test",
		"typecheck": "tsc --noEmit",
		"screenshots": "node scripts/render-screenshots.ts",
		"prepublishOnly": "npm test && npm run typecheck"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MiguezPablo/gentle-herdr-status.git"
	},
	"homepage": "https://github.com/MiguezPablo/gentle-herdr-status#readme",
	"bugs": {
		"url": "https://github.com/MiguezPablo/gentle-herdr-status/issues"
	}
}
